# CRM lead-intake API. Both are NEXT_PUBLIC and ship in the client bundle:
# the secret is an identifier, not a credential (the CRM enforces origin +
# rate limits). These must also be set in the Vercel project, Production and
# Preview, because .env.local is gitignored.
NEXT_PUBLIC_CRM_INTAKE_URL=https://irlerp.vercel.app/api/intake/lead
NEXT_PUBLIC_INTAKE_SECRET=<ask-the-CRM-for-this>

# Digital Franchise partner intake. Separate endpoint from the lead intake above
# because a partner enquiry is not a travel Lead; it shares the same secret.
# Until this is set the franchise form still opens WhatsApp, but it tells the
# visitor their details were not saved rather than promising a callback.
NEXT_PUBLIC_CRM_PARTNER_URL=https://irlerp.vercel.app/api/intake/partner
