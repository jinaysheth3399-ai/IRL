# CRM lead-intake API. Both are NEXT_PUBLIC and ship in the client bundle:
# the secret is an identifier, not a credential (the CRM enforces origin +
# rate limits). These must also be set in the Vercel project, Production and
# Preview, because .env.local is gitignored.
NEXT_PUBLIC_CRM_INTAKE_URL=https://irlerp.vercel.app/api/intake/lead
NEXT_PUBLIC_INTAKE_SECRET=<ask-the-CRM-for-this>
